.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Model artifacts (large binaries — managed separately) ────────────────────
models/*.pkl
models/*.joblib
models/*.bin

# ── Data — keep directory structure, ignore generated/downloaded files ─────────
data/raw/*
data/processed/*
data/interim/freight_forecast_30d.json
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep

# ── OS artefacts ──────────────────────────────────────────────────────────────
